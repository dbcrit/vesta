# SPDX-License-Identifier: Apache-2.0
# Pinned upstream inputs for the vesta guest kernel and rootfs image.
# Sourced by images/guest/lib.sh and read by the top-level Makefile.
# Bump KATA_VERSION and KATA_COMMIT together; lib.sh refuses a tag that
# resolves to a different commit.

KATA_VERSION=4.2.0
KATA_COMMIT=c7351e797efff8bfc6bd73da0eb1909be12e2cfe
KATA_REPO=https://github.com/kata-containers/kata-containers.git

# Guest kernel as listed in Kata 4.2.0 versions.yaml (assets.kernel.version).
# kernel/build.sh cross-checks this against the checked-out versions.yaml.
KERNEL_VERSION=6.18.35

# Rootfs distro and release of Kata's stock image (versions.yaml assets.image; 26.04 LTS).
ROOTFS_DISTRO=ubuntu
ROOTFS_OS_VERSION=resolute
